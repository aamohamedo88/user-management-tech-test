@model UserManagement.Web.Models.Users.ViewUserViewModel

<h2>View User</h2>

<dl class="row">

    <dt class="col-sm-3">Forename</dt>
    <dd class="col-sm-9">@Model.Forename</dd>

    <dt class="col-sm-3">Surname</dt>
    <dd class="col-sm-9">@Model.Surname</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Date of Birth</dt>
    <dd class="col-sm-9">@Model.DateOfBirth.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Account Active</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>

</dl>

<a asp-controller="Users"
   asp-action="List"
   class="btn btn-secondary">
    Back to List
</a>
