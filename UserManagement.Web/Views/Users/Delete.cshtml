@model UserManagement.Web.Models.Users.DeleteUserViewModel

<h2>Delete User</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this user?
</div>

<dl class="row">
    <dt class="col-sm-3">Forename</dt>
    <dd class="col-sm-9">@Model.Forename</dd>

    <dt class="col-sm-3">Surname</dt>
    <dd class="col-sm-9">@Model.Surname</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
</dl>

<form asp-controller="Users"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-controller="Users"
       asp-action="List"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
