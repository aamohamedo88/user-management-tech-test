@model UserManagement.Web.Models.Logs.LogListViewModel

<h2>Logs</h2>

@if (Model.Items.Any())
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.UserDisplayName</td>
                        <td>@item.Action</td>
                        <td>@item.Details</td>
                        <td>@item.TimestampUtc.ToString("dd/MM/yyyy HH:mm")</td>

                        <td>
                            <a asp-controller="Logs"
                               asp-action="View"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-secondary">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        @if (Model.CurrentPage > 1)
        {
            <a asp-controller="Logs"
               asp-action="List"
               asp-route-page="@(Model.CurrentPage - 1)"
               class="btn btn-secondary">
                Previous
            </a>
        }

        <span class="mx-2">
            Page @Model.CurrentPage of @Model.TotalPages
        </span>

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-controller="Logs"
               asp-action="List"
               asp-route-page="@(Model.CurrentPage + 1)"
               class="btn btn-secondary">
                Next
            </a>
        }
    </div>
}
else
{
    <p>No log entries have been recorded.</p>
}
